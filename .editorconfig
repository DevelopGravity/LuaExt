# EditorConfig: https://editorconfig.org
# Enforced in CI by lint.yml via editorconfig-checker.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Vendored upstream Lua keeps its own upstream formatting untouched.
[third_party/**]
insert_final_newline = unset
trim_trailing_whitespace = unset

# C/C++ sources and headers: tabs, Zend/PHP-src style. clang-format is the
# authority here and aligns continuation lines with spaces after the tab
# indent, which is why CI does not machine-check indentation.
[*.{c,h,cc,cpp,hpp}]
indent_style = tab
indent_size = 4

# PHP: spaces, PSR-12. These files are userland-facing -- the stubs are
# published for editors and static analysers -- so they follow the convention
# their readers expect rather than php-src's internal one.
[*.php]
indent_style = space
indent_size = 4

# .phpt test bodies follow the C side, matching php-src's own test suite.
[*.phpt]
indent_style = tab
indent_size = 4

# Shell scripts.
[*.sh]
indent_style = space
indent_size = 4

# Makefiles require tab indentation for recipes.
[Makefile*]
indent_style = tab

# YAML/JSON/config: 2-space indentation.
[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[.gitmodules]
indent_style = tab
