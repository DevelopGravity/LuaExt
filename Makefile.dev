# Makefile.dev — developer convenience targets.
#
# This is NOT the extension's build Makefile (that one is generated by
# `phpize && ./configure` and lives at ./Makefile once you've run those).
# This wraps that build plus the repo's own tooling so day-to-day commands
# are one word long.
#
# Usage:
#   make -f Makefile.dev <target>
# or, more conveniently, symlink it once:
#   ln -s Makefile.dev GNUmakefile && make <target>
#
# macOS arm64 quick start: brew install php, then `make -f Makefile.dev build`.
# No system Lua is ever required — Lua is vendored and compiled in-tree.

SHELL := /bin/bash
PHP ?= php
JOBS ?= $(shell getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)
FUZZ_SECONDS ?= 30

.PHONY: build build-debug test format format-check vendor-verify gen-stubs gen-stubs-check docs-check build-ide-stubs fuzz clean

## Configure + build a release extension build.
build:
	phpize
	./configure
	$(MAKE) -j$(JOBS)

## Configure + build with --enable-luaext-debug.
build-debug:
	phpize
	./configure --enable-luaext-debug
	$(MAKE) -j$(JOBS)

## Build (release) and run the .phpt suite.
test: build
	$(MAKE) test

## Formatting uses a PINNED clang-format (see .github/workflows/lint.yml).
## Versions disagree about output -- 18.1.3 and 18.1.8 differ on brace spacing
## in a macro -- so CI installs an exact version, and a mismatched local binary
## produces a diff CI then rejects. Get the same one with:
##   python3 -m venv .venv && .venv/bin/pip install clang-format==18.1.8
## then: make -f Makefile.dev format CLANG_FORMAT=.venv/bin/clang-format
CLANG_FORMAT ?= clang-format

## Reformat our own C sources in place. Vendored Lua (third_party/) and
## generated arginfo are never touched.
format:
	@dirs=""; \
	for d in src fuzz; do [ -d "$$d" ] && dirs="$$dirs $$d"; done; \
	if [ -z "$$dirs" ]; then echo "No src/ or fuzz/ yet — nothing to format."; exit 0; fi; \
	find $$dirs -type f \( -name '*.c' -o -name '*.h' \) ! -name '*_arginfo.h' -exec $(CLANG_FORMAT) -i {} +

## Check formatting without writing (what lint.yml runs).
format-check:
	@dirs=""; \
	for d in src fuzz; do [ -d "$$d" ] && dirs="$$dirs $$d"; done; \
	if [ -z "$$dirs" ]; then echo "No src/ or fuzz/ yet — nothing to format-check."; exit 0; fi; \
	find $$dirs -type f \( -name '*.c' -o -name '*.h' \) ! -name '*_arginfo.h' -exec $(CLANG_FORMAT) --dry-run --Werror {} +

## Verify third_party/lua-5.5.1 still matches the pinned upstream tarball
## plus patches/*.patch (tools/vendor-lua.sh belongs to the vendoring
## workstream; this just calls it).
vendor-verify:
	tools/vendor-lua.sh --check

## Regenerate arginfo from stubs/*.stub.php.
gen-stubs:
	tools/gen-stubs.sh

## Check arginfo is up to date without writing.
gen-stubs-check:
	tools/gen-stubs.sh --check

## Verify documentation samples only reference API that exists. Catches
## wrong named arguments, which a syntax check cannot see.
docs-check:
	php tools/check-docs-api.php

## Build the polished, IDE-facing stub package sources into ide-stubs/.
## tools/build-ide-stubs.php belongs to the stub-authoring workstream.
build-ide-stubs:
	@if [ ! -f tools/build-ide-stubs.php ]; then \
		echo "tools/build-ide-stubs.php not present yet."; exit 1; \
	fi
	$(PHP) tools/build-ide-stubs.php

## Build and run every fuzz/fuzz_*.c target for FUZZ_SECONDS each (default
## 30s; CI's fuzz.yml uses a longer default). fuzz/ is a later-phase
## deliverable of a different workstream.
fuzz:
	@if [ ! -f fuzz/Makefile ]; then \
		echo "fuzz/ not present yet."; exit 1; \
	fi
	$(MAKE) -C fuzz
	@for src in fuzz/fuzz_*.c; do \
		[ -e "$$src" ] || continue; \
		target="$${src%.c}"; \
		if [ -x "$$target" ]; then \
			echo "== $$target (%FUZZ_SECONDS%s) ==" | sed "s/%FUZZ_SECONDS%/$(FUZZ_SECONDS)/"; \
			mkdir -p "fuzz/corpus/$$(basename "$$target")"; \
			"$$target" -max_total_time=$(FUZZ_SECONDS) "fuzz/corpus/$$(basename "$$target")"; \
		fi; \
	done

## Remove build artifacts and tooling caches.
clean:
	@if [ -f Makefile ] && [ -f config.status ]; then $(MAKE) clean; fi
	rm -rf .tools-cache ide-stubs
