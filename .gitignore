# phpize / autoconf build tree
/autom4te.cache/
/build/
/configure
/configure.ac
/config.h
/configure.ac.bak
/config.h.in
/config.h.in~
/config.cache
/config.log
/config.nice
/config.status
/main/php_config.h
/Makefile
/Makefile.fragments
/Makefile.objects
/mkinstalldirs
/install-sh
/missing
/ltmain.sh
/libtool
/run-tests.php
/scripts/phpize

# Compiled objects / build output. *.dep are the -MMD dependency stamps the
# php build system drops beside every source, including inside third_party/.
*.lo
*.o
*.dep
*.la
*.a
*.so
*.dll
*.dylib
*.exp
*.pdb
*.gcno
*.gcda
.libs/
modules/
ide-stubs/

# .phpt test run artifacts (run-tests.php leaves these next to the .phpt, so
# the patterns must reach subdirectories such as tests/00-build/)
tests/**/*.out
tests/**/*.diff
tests/**/*.log
tests/**/*.exp
tests/**/*.php
tests/**/*.sh
tests/**/*.mem
tests/*.out
tests/*.diff
tests/*.log
tests/*.exp
tests/*.php
tests/*.sh
tests/*.mem
!tests/**/*.phpt
tmp-php.ini
php_test_results_*.txt

# Windows build output (php-windows-builder / local BuildPhpExtension runs)
artifacts/

# Tooling caches (gen-stubs.sh, check-lua-upstream.sh, etc.) — never committed
.tools-cache/

# gen_stub.php writes *_arginfo.h next to each stubs/*.stub.php it processes;
# tools/gen-stubs.sh then copies those into src/, which is the committed
# generated artifact per the repo layout. The stubs/ copies are intermediate.
stubs/*_arginfo.h
stubs/**/*_arginfo.h

# Fuzzing corpora/crashes (kept out of the tree; fuzz.yml uploads them as
# workflow artifacts instead)
fuzz/corpus/
fuzz/crashes/
fuzz/*.o
# Built targets. Makefile.dev globs fuzz/fuzz_*.c and builds ${src%.c}, so the
# binaries are fuzz/fuzz_<name> with no suffix -- the older *_fuzzer pattern
# never matched one and would have let a 3 MB instrumented binary into the tree.
fuzz/fuzz_*
!fuzz/*.c
!fuzz/Makefile

# Agent scratch space. Worktrees created here are whole checkouts with their own
# .git, so committing one embeds a repository inside this one.
.claude/

# Editor / OS cruft
.DS_Store
*.swp
*~
.idea/
.vscode/

# Local maintenance scripts (history sweeps, signing shims). Not shipped.
.tools/
