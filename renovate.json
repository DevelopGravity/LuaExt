{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitTypeAll(chore)"],
  "labels": ["dependencies"],
  "github-actions": {
    "enabled": true,
    "pinDigests": true
  },
  "composer": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group all GitHub Actions digest/version bumps into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "matchUpdateTypes": ["minor", "patch", "digest"]
    },
    {
      "description": "Major action bumps land separately so the pinned SHA comment and any behavior change get reviewed on their own",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "groupName": null
    }
  ]
}
